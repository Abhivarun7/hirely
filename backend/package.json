{
  "name": "hirely-backend",
  "version": "1.0.0",
  "description": "Hirely Job Portal Backend API",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "seed": "tsx src/scripts/seed.ts",
    "seed:seekers": "tsx src/scripts/seed-seekers.ts",
    "seed:companies": "tsx src/scripts/seed-companies.ts",
    "seed:officials": "tsx src/scripts/seed-officials.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.529.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dns": "^0.2.2",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.9",
    "openai": "^6.35.0",
    "pino": "^8.18.0",
    "pino-http": "^9.0.0",
    "qrcode": "^1.5.3",
    "sanitize-html": "^2.12.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mongo-sanitize": "^1.0.3",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.9.5",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
